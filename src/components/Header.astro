---
import ThemeToggle from "./ThemeToggle.astro"

const navItems = [
  { title: "Experiencia", label: "experiencia", url: "/#experiencia" },
  { title: "Stack", label: "competencias", url: "/#competencias" },
  { title: "Proyectos", label: "proyectos", url: "/#proyectos" },
  { title: "Perfil", label: "sobre-mi", url: "/#sobre-mi" },
]
---

<header class="fixed inset-x-0 top-3 z-50 flex justify-center px-2">
  <nav
    id="header-nav"
    aria-label="Navegación principal"
    class="flex items-center justify-center rounded-full px-2 text-xs font-medium text-slate-600 dark:text-slate-200 sm:px-3 sm:text-sm"
  >
    {
      navItems.map((link) => (
        <a
          class="relative block whitespace-nowrap px-2 py-2 transition hover:text-blue-600 focus-visible:rounded-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 dark:hover:text-blue-300 sm:px-3"
          aria-label={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }
    <ThemeToggle />
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section[id]")
    const navItems = document.querySelectorAll<HTMLAnchorElement>("header nav a")

    const observer = new IntersectionObserver(
      (entries) => {
        const visibleSection = entries.find((entry) => entry.isIntersecting)
        if (!visibleSection) return

        navItems.forEach((item) => {
          const isActive = item.getAttribute("aria-label") === visibleSection.target.id
          item.classList.toggle("text-blue-600", isActive)
          item.classList.toggle("dark:text-blue-300", isActive)
          if (isActive) {
            item.setAttribute("aria-current", "page")
          } else {
            item.removeAttribute("aria-current")
          }
        })
      },
      { rootMargin: "-25% 0px -60%", threshold: 0 },
    )

    sections.forEach((section) => observer.observe(section))
    document.addEventListener("astro:before-swap", () => observer.disconnect(), {
      once: true,
    })
  })
</script>

<style>
  nav {
    animation: nav-shadow 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
    @apply bg-white/60 dark:bg-slate-900/60;
  }

  @keyframes nav-shadow {
    from {
      box-shadow: none;
      backdrop-filter: blur(0);
    }
    to {
      box-shadow:
        0 10px 15px -3px rgb(15 23 42 / 0.08),
        0 4px 6px -4px rgb(15 23 42 / 0.08);
      backdrop-filter: blur(20px);
    }
  }
</style>
