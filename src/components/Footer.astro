---
import profile from "@/data/profile.json"

const currentYear = new Date().getFullYear()
const { meta } = profile
---

<footer class="mx-auto mt-20 w-full max-w-4xl px-5 pb-10 sm:px-6">
  <div
    class="flex flex-col gap-4 border-t border-slate-200 pt-8 text-sm text-slate-600 dark:border-slate-800 dark:text-slate-400 sm:flex-row sm:items-center sm:justify-between"
  >
    <p>
      © {currentYear}
      <a
        href="/#inicio"
        class="font-semibold text-slate-800 hover:text-blue-600 dark:text-slate-200 dark:hover:text-blue-300"
      >
        {meta.name}
      </a>
    </p>
    <nav class="flex flex-wrap gap-5" aria-label="Enlaces del pie de página">
      <a href="/casos-de-estudio" class="transition hover:text-blue-600 dark:hover:text-blue-300">
        Casos de estudio
      </a>
      <a href="/#sobre-mi" class="transition hover:text-blue-600 dark:hover:text-blue-300">Perfil</a>
      <a href={meta.links.cvEs} download class="transition hover:text-blue-600 dark:hover:text-blue-300">
        CV
      </a>
      <a href={`mailto:${meta.email}`} class="transition hover:text-blue-600 dark:hover:text-blue-300">
        Contacto
      </a>
      <a
        href={meta.links.github}
        target="_blank"
        rel="noopener noreferrer"
        class="transition hover:text-blue-600 dark:hover:text-blue-300"
      >
        GitHub
      </a>
      <a
        href={meta.links.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="transition hover:text-blue-600 dark:hover:text-blue-300"
      >
        LinkedIn
      </a>
    </nav>
  </div>
</footer>
