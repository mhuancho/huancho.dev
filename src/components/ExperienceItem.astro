---
interface Props {
  title: string
  company: string
  description: string
  highlights: string[]
  technologies: string[]
  date: string
}

const { title, company, description, highlights, technologies, date } = Astro.props
---

<article class="relative pb-14 pl-7 last:pb-0 sm:pl-10">
  <span class="absolute -left-[7px] top-2 size-3 rounded-full bg-blue-600 ring-4 ring-gray-50 dark:bg-blue-400 dark:ring-gray-950"></span>

  <div class="grid gap-5 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-10">
    <header>
      <p class="text-sm font-semibold uppercase tracking-wider text-blue-700 dark:text-blue-300">{date}</p>
      <h3 class="mt-2 text-xl font-bold text-slate-950 dark:text-white">{title}</h3>
      <p class="mt-1 font-semibold text-slate-600 dark:text-slate-300">{company}</p>
    </header>

    <div>
      <p class="leading-7 text-slate-700 dark:text-slate-300">{description}</p>
      <ul class="mt-4 space-y-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
        {
          highlights.map((highlight) => (
            <li class="flex gap-3">
              <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-cyan-500"></span>
              <span>{highlight}</span>
            </li>
          ))
        }
      </ul>
      <ul class="mt-5 flex flex-wrap gap-2" aria-label={`Tecnologías usadas en ${company}`}>
        {
          technologies.map((technology) => (
            <li class="rounded-md bg-slate-200/70 px-2.5 py-1 text-xs font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-200">
              {technology}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</article>
