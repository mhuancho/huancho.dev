---
import profile from "@/data/profile.json"

const { about } = profile
---

<div class="grid gap-8 lg:grid-cols-[minmax(0,1.4fr)_minmax(16rem,0.6fr)]">
  <article class="space-y-5 text-lg leading-8 text-slate-700 dark:text-slate-300">
    {about.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
  </article>

  <aside
    class="rounded-3xl border border-slate-200 bg-white/70 p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/60"
    aria-label="Formación y perfil"
  >
    <dl class="space-y-5">
      {
        about.facts.map((fact, index) => (
          <div class={index === 0 ? "" : "border-t border-slate-200 pt-5 dark:border-slate-800"}>
            <dt class="text-xs font-semibold uppercase tracking-wider text-blue-700 dark:text-blue-300">
              {fact.label}
            </dt>
            <dd class="mt-1 font-semibold text-slate-950 dark:text-white">{fact.value}</dd>
            <dd class="text-sm text-slate-600 dark:text-slate-400">{fact.detail}</dd>
          </div>
        ))
      }
    </dl>
  </aside>
</div>
