---
import LinkIcon from "./icons/Link.astro"
import LinkButton from "./LinkButton.astro"

interface Project {
  eyebrow: string
  title: string
  description: string
  highlights: string[]
  tags: string[]
  shortCode: string
  accent: string
  image?: string
  link?: string
}

const projects: Project[] = [
  {
    eyebrow: "Gateways y resiliencia",
    title: "Capa de seguridad de una plataforma FACTUS PSE",
    description:
      "Puerta de entrada multi-tenant de una plataforma de facturación electrónica: resuelve el destino de cada solicitud por RUC y aísla los fallos de los sistemas downstream.",
    highlights: [
      "Carga multipart en streaming a disco temporal, sin bufferizar archivos en memoria.",
      "API Key por RUC, enrutamiento cacheado y gateways reactivos con Spring Cloud Gateway y R2DBC.",
      "Librería propia de circuit breaker, retry, bulkhead y time limiter sobre Resilience4j.",
    ],
    tags: ["Java 21", "Quarkus 3", "Spring Boot 4", "Resilience4j", "Virtual Threads"],
    shortCode: "FACTUS PSE",
    accent: "from-rose-500 via-pink-600 to-fuchsia-700",
  },
  {
    eyebrow: "Mensajería asíncrona",
    title: "Procesamiento de comprobantes por lotes",
    description:
      "Productor y worker que sacan el procesamiento de paquetes masivos fuera del camino síncrono de subida, con garantías de idempotencia y reintento.",
    highlights: [
      "Spring Cloud Stream sobre RabbitMQ, con el paquete persistido en S3 y el evento en cola.",
      "Bloques de 1000 comprobantes con republicación del evento restante para evitar timeouts.",
      "Trazabilidad e idempotencia en PostgreSQL: los fallidos se reintentan sin reprocesar lo confirmado.",
    ],
    tags: ["Spring Boot 4.1", "RabbitMQ", "AWS S3", "PostgreSQL", "Virtual Threads"],
    shortCode: "BATCH",
    accent: "from-violet-600 via-indigo-600 to-blue-600",
  },
  {
    eyebrow: "Seguridad e identidad",
    title: "IAM, SPI de Keycloak y temas corporativos",
    description:
      "Extensión de Keycloak para un modelo de acceso por empresa: login con RUC, alta de usuarios secundarios y experiencia de acceso propia por cliente.",
    highlights: [
      "SPI Authenticator con login RUC + usuario y provisioning Just-In-Time desde base legacy.",
      "SPI FormAction de preregistro de usuarios secundarios con validación de empresa y duplicados.",
      "Dos temas FreeMarker con MFA TOTP/OTP, 9 idiomas y branding dinámico resuelto por dominio.",
    ],
    tags: ["Keycloak 26", "SPI / FreeMarker", "Quarkus 3", "OAuth2 / OIDC", "MFA"],
    shortCode: "FACTUS - IAM",
    accent: "from-emerald-500 via-teal-500 to-cyan-600",
  },
  {
    eyebrow: "Micro-Frontends",
    title: "Plataforma MFE con Nx y Native Federation",
    description:
      "Monorepo con un host shell y remotos federados por dominio: documentos, trazabilidad, analítica, facturación, IAM, tenant, reportes y compras.",
    highlights: [
      "Contrato de navegación: cada remoto expone getNavItems() y el shell fusiona, deduplica y filtra por entitlements.",
      "Componentes standalone con signals y OnPush, TypeScript estricto y librerías compartidas.",
      "CSS compilado por remoto sobre una base Tailwind común, sin dependencia de estilos del shell.",
    ],
    tags: ["Nx 22", "Angular 21", "Native Federation", "Signals", "Tailwind 4"],
    shortCode: "FACTUS -MFE",
    accent: "from-orange-500 via-rose-500 to-pink-600",
  },
  {
    eyebrow: "Ecosistema de servicios",
    title: "Onboarding, correo y documentos electrónicos",
    description:
      "Conjunto de servicios de dominio que comparten contrato técnico: onboarding empresarial, correo corporativo, registro de compras y generación documental.",
    highlights: [
      "Onboarding con documentos en S3, contratos, tareas y jobs programados de seguimiento.",
      "Registro de compras electrónico reactivo con WebFlux, R2DBC y routers funcionales.",
      "Filestore con JasperReports, iText 7, PDFBox y ZXing para reportes, PDFs y códigos QR.",
    ],
    tags: ["Quarkus 3", "Spring Boot 4", "R2DBC", "AWS S3 / SES", "JasperReports"],
    shortCode: "CORE",
    accent: "from-cyan-500 via-sky-600 to-blue-700",
  },
  {
    eyebrow: "Agentes de IA",
    title: "model-farm · scaffold Spec Kit",
    description:
      "Agente de especificación que deriva la identidad de un proyecto desde su ruta y su contrato OpenAPI, en lugar de quedar atado a un API concreto.",
    highlights: [
      "Ciclo specify → plan → tasks → implement con scripts equivalentes en PowerShell y Bash.",
      "Clasifica la solicitud: proyecto nuevo, nuevo con OpenAPI predefinido o cambio sobre existente.",
      "Historial versionado de artefactos y changelog generado desde las notas de cambio.",
    ],
    tags: ["Spec Kit", "OpenAPI", "PowerShell", "Bash", "Automatización"],
    shortCode: "IA",
    accent: "from-slate-700 via-slate-800 to-slate-950",
  },
  {
    eyebrow: "Arquitectura y eventos",
    title: "Plataforma transaccional event-driven",
    description:
      "Backend para procesos comerciales con control de stock, consistencia transaccional, auditoría y publicación confiable de eventos.",
    highlights: [
      "Outbox Pattern con reintentos y control de estados operativos.",
      "Seguridad JWT/JWKS, Flyway, HikariCP y preparación Native Image.",
    ],
    tags: ["Java 21", "Micronaut 4", "Kafka", "PostgreSQL", "GraalVM"],
    shortCode: "EVT",
    accent: "from-lime-500 via-emerald-600 to-teal-700",
  },
  {
    eyebrow: "Comercio exterior",
    title: "VUCE 2.0",
    description:
      "Microservicios y procesos portuarios para trámites, trazabilidad documental e integración entre actores de comercio exterior.",
    highlights: [
      "APIs contract-first, arquitectura hexagonal y capa de experiencia.",
      "Firma digital, JasperReports, Redis, Kafka, Feign y Camunda BPM.",
    ],
    tags: ["Java 17", "Spring Boot 3", "Quarkus", "Angular 17", "Camunda"],
    shortCode: "VUCE",
    accent: "from-sky-500 via-blue-600 to-indigo-700",
    image: "/projects/vuce20.webp",
    link: "https://landing-desa.vuce.gob.pe/cp2/gestionduenave/",
  },
  {
    eyebrow: "Sector regulado",
    title: "STE - OSINERGMIN",
    description:
      "Automatización de procesos técnicos y económicos del Sistema de Transmisión Eléctrica con trazabilidad y ejecución controlada.",
    highlights: [
      "Procesos BPMN para planificación, valorización, COyM, SST y SCT.",
      "Reglas de negocio, cálculos regulatorios y optimización con Redis.",
    ],
    tags: ["Java", "Spring Boot", "Quarkus", "Camunda 7", "Redis"],
    shortCode: "STE",
    accent: "from-amber-500 via-orange-500 to-red-600",
    image: "/projects/ste.webp",
  },
]
---

<div class="grid gap-6 md:grid-cols-2">
  {
    projects.map((project) => (
      <article class="group overflow-hidden rounded-3xl border border-slate-200 bg-white/75 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl dark:border-slate-800 dark:bg-slate-900/70">
        <div class="relative h-48 overflow-hidden">
          {
            project.image ? (
              <img
                src={project.image}
                alt={`Vista del proyecto ${project.title}`}
                width="800"
                height="450"
                loading="lazy"
                class="h-full w-full object-cover object-top transition duration-500 group-hover:scale-105"
              />
            ) : (
              <div class:list={["flex h-full items-center justify-center bg-gradient-to-br", project.accent]}>
                <span class="text-5xl font-black tracking-widest text-white/90">{project.shortCode}</span>
              </div>
            )
          }
          <span class="absolute left-4 top-4 rounded-full bg-slate-950/75 px-3 py-1 text-xs font-semibold text-white backdrop-blur">
            {project.eyebrow}
          </span>
        </div>

        <div class="p-6">
          <h3 class="text-2xl font-bold text-slate-950 dark:text-white">{project.title}</h3>
          <p class="mt-3 leading-7 text-slate-600 dark:text-slate-300">{project.description}</p>
          <ul class="mt-4 space-y-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
            {
              project.highlights.map((highlight) => (
                <li class="flex gap-3">
                  <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-blue-500"></span>
                  <span>{highlight}</span>
                </li>
              ))
            }
          </ul>
          <ul class="mt-5 flex flex-wrap gap-2" aria-label={`Tecnologías del proyecto ${project.title}`}>
            {
              project.tags.map((tag) => (
                <li class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-200">
                  {tag}
                </li>
              ))
            }
          </ul>
          {
            project.link && (
              <footer class="mt-6">
                <LinkButton href={project.link}>
                  <LinkIcon class="size-4" />
                  Ver proyecto
                </LinkButton>
              </footer>
            )
          }
        </div>
      </article>
    ))
  }
</div>
