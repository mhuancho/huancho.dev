---
import LinkIcon from "./icons/Link.astro"
import LinkButton from "./LinkButton.astro"

interface Project {
  eyebrow: string
  title: string
  description: string
  highlights: string[]
  tags: string[]
  shortCode: string
  accent: string
  image?: string
  link?: string
}

const projects: Project[] = [
  {
    eyebrow: "Seguridad e identidad",
    title: "IAM y autenticación multifactor",
    description:
      "Solución multi-cliente para centralizar autenticación, autorización y administración de usuarios en una plataforma empresarial.",
    highlights: [
      "SPI personalizados, validación corporativa y aprovisionamiento Just-In-Time.",
      "MFA TOTP/OTP, JWT estandarizados, roles, grupos y auditoría.",
    ],
    tags: ["Java 17", "Spring Boot 3", "Keycloak 26", "OAuth2 / OIDC", "PostgreSQL"],
    shortCode: "IAM",
    accent: "from-emerald-500 via-teal-500 to-cyan-600",
  },
  {
    eyebrow: "Arquitectura y eventos",
    title: "Plataforma transaccional event-driven",
    description:
      "Backend para procesos comerciales con control de stock, consistencia transaccional, auditoría y publicación confiable de eventos.",
    highlights: [
      "Outbox Pattern con reintentos y control de estados operativos.",
      "Seguridad JWT/JWKS, Flyway, HikariCP y preparación Native Image.",
    ],
    tags: ["Java 21", "Micronaut 4", "Kafka", "PostgreSQL", "GraalVM"],
    shortCode: "EVT",
    accent: "from-violet-600 via-indigo-600 to-blue-600",
  },
  {
    eyebrow: "Comercio exterior",
    title: "VUCE 2.0",
    description:
      "Microservicios y procesos portuarios para trámites, trazabilidad documental e integración entre actores de comercio exterior.",
    highlights: [
      "APIs contract-first, arquitectura hexagonal y capa de experiencia.",
      "Firma digital, JasperReports, Redis, Kafka, Feign y Camunda BPM.",
    ],
    tags: ["Java 17", "Spring Boot 3", "Quarkus", "Angular 17", "Camunda"],
    shortCode: "VUCE",
    accent: "from-sky-500 via-blue-600 to-indigo-700",
    image: "/projects/vuce20.webp",
    link: "https://landing-desa.vuce.gob.pe/cp2/gestionduenave/",
  },
  {
    eyebrow: "Sector regulado",
    title: "STE - OSINERGMIN",
    description:
      "Automatización de procesos técnicos y económicos del Sistema de Transmisión Eléctrica con trazabilidad y ejecución controlada.",
    highlights: [
      "Procesos BPMN para planificación, valorización, COyM, SST y SCT.",
      "Reglas de negocio, cálculos regulatorios y optimización con Redis.",
    ],
    tags: ["Java", "Spring Boot", "Quarkus", "Camunda 7", "Redis"],
    shortCode: "STE",
    accent: "from-amber-500 via-orange-500 to-red-600",
    image: "/projects/ste.webp",
  },
]
---

<div class="grid gap-6 md:grid-cols-2">
  {
    projects.map((project) => (
      <article class="group overflow-hidden rounded-3xl border border-slate-200 bg-white/75 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl dark:border-slate-800 dark:bg-slate-900/70">
        <div class="relative h-48 overflow-hidden">
          {
            project.image ? (
              <img
                src={project.image}
                alt={`Vista del proyecto ${project.title}`}
                width="800"
                height="450"
                loading="lazy"
                class="h-full w-full object-cover object-top transition duration-500 group-hover:scale-105"
              />
            ) : (
              <div class:list={["flex h-full items-center justify-center bg-gradient-to-br", project.accent]}>
                <span class="text-5xl font-black tracking-widest text-white/90">{project.shortCode}</span>
              </div>
            )
          }
          <span class="absolute left-4 top-4 rounded-full bg-slate-950/75 px-3 py-1 text-xs font-semibold text-white backdrop-blur">
            {project.eyebrow}
          </span>
        </div>

        <div class="p-6">
          <h3 class="text-2xl font-bold text-slate-950 dark:text-white">{project.title}</h3>
          <p class="mt-3 leading-7 text-slate-600 dark:text-slate-300">{project.description}</p>
          <ul class="mt-4 space-y-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
            {
              project.highlights.map((highlight) => (
                <li class="flex gap-3">
                  <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-blue-500"></span>
                  <span>{highlight}</span>
                </li>
              ))
            }
          </ul>
          <ul class="mt-5 flex flex-wrap gap-2" aria-label={`Tecnologías del proyecto ${project.title}`}>
            {
              project.tags.map((tag) => (
                <li class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-200">
                  {tag}
                </li>
              ))
            }
          </ul>
          {
            project.link && (
              <footer class="mt-6">
                <LinkButton href={project.link}>
                  <LinkIcon class="size-4" />
                  Ver proyecto
                </LinkButton>
              </footer>
            )
          }
        </div>
      </article>
    ))
  }
</div>
