---
import LinkIcon from "./icons/Link.astro"
import LinkButton from "./LinkButton.astro"
import projectsData from "@/data/projects.json"

interface Project {
  eyebrow: string
  title: string
  description: string
  highlights: string[]
  tags: string[]
  shortCode: string
  accent: string
  image?: string
  link?: string
  /** slug del caso de estudio ampliado, si existe */
  caseStudy?: string
}

const projects: Project[] = projectsData
---

<div class="grid gap-6 md:grid-cols-2">
  {
    projects.map((project) => (
      <article class="group overflow-hidden rounded-3xl border border-slate-200 bg-white/75 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl dark:border-slate-800 dark:bg-slate-900/70">
        <div class="relative h-48 overflow-hidden">
          {
            project.image ? (
              <img
                src={project.image}
                alt={`Vista del proyecto ${project.title}`}
                width="800"
                height="450"
                loading="lazy"
                class="h-full w-full object-cover object-top transition duration-500 group-hover:scale-105"
              />
            ) : (
              <div class:list={["flex h-full items-center justify-center bg-gradient-to-br", project.accent]}>
                <span class="text-5xl font-black tracking-widest text-white/90">{project.shortCode}</span>
              </div>
            )
          }
          <span class="absolute left-4 top-4 rounded-full bg-slate-950/75 px-3 py-1 text-xs font-semibold text-white backdrop-blur">
            {project.eyebrow}
          </span>
        </div>

        <div class="p-6">
          <h3 class="text-2xl font-bold text-slate-950 dark:text-white">{project.title}</h3>
          <p class="mt-3 leading-7 text-slate-600 dark:text-slate-300">{project.description}</p>
          <ul class="mt-4 space-y-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
            {
              project.highlights.map((highlight) => (
                <li class="flex gap-3">
                  <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-blue-500"></span>
                  <span>{highlight}</span>
                </li>
              ))
            }
          </ul>
          <ul class="mt-5 flex flex-wrap gap-2" aria-label={`Tecnologías del proyecto ${project.title}`}>
            {
              project.tags.map((tag) => (
                <li class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-200">
                  {tag}
                </li>
              ))
            }
          </ul>
          {
            (project.link || project.caseStudy) && (
              <footer class="mt-6 flex flex-wrap gap-3">
                {project.caseStudy && (
                  <a
                    href={`/casos-de-estudio#${project.caseStudy}`}
                    class="inline-flex max-w-fit items-center justify-center gap-2 rounded-xl border border-blue-300 bg-blue-50 px-3 py-2 text-sm font-semibold text-blue-900 transition hover:border-blue-600 hover:bg-blue-600 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 dark:border-blue-800 dark:bg-blue-950/60 dark:text-blue-100 dark:hover:bg-blue-600"
                  >
                    Leer el caso de estudio
                  </a>
                )}
                {project.link && (
                  <LinkButton href={project.link}>
                    <LinkIcon class="size-4" />
                    Ver proyecto
                  </LinkButton>
                )}
              </footer>
            )
          }
        </div>
      </article>
    ))
  }
</div>
