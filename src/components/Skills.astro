---
const skillGroups = [
  {
    title: "Backend",
    description: "Servicios robustos, reactivos y orientados a dominio.",
    skills: ["Java 8/11/17/21", "Spring Boot 3/4", "WebFlux", "R2DBC", "Quarkus 3", "Micronaut 4", "Panache", "Virtual Threads"],
  },
  {
    title: "Arquitectura e integración",
    description: "Límites claros, contratos explícitos y consistencia operativa.",
    skills: ["Arquitectura hexagonal", "Clean Architecture", "DDD", "Microservicios", "API Gateway", "Capa de experiencia (BFF)", "OpenAPI", "CQRS"],
  },
  {
    title: "Seguridad e identidad",
    description: "Identidad centralizada y acceso controlado por tenant.",
    skills: ["Keycloak 26", "SPI Authenticator", "Themes FreeMarker", "OAuth2 / OIDC", "JWT / JWKS", "MFA / TOTP", "RBAC", "API Keys"],
  },
  {
    title: "Datos y mensajería",
    description: "Persistencia relacional, NoSQL e integración asíncrona.",
    skills: ["PostgreSQL", "SQL Server", "Oracle", "MongoDB", "Redis", "Kafka", "RabbitMQ", "Spring Cloud Stream"],
  },
  {
    title: "Resiliencia y observabilidad",
    description: "Fallos aislados y sistemas que se pueden diagnosticar.",
    skills: ["Resilience4j", "Circuit breaker", "Retry / Bulkhead", "Time limiter", "Micrometer", "Prometheus", "Health checks", "Trace ID"],
  },
  {
    title: "Procesos y automatización",
    description: "Orquestación de negocio y generación asistida de artefactos.",
    skills: ["Camunda 7/8", "BPMN / DMN", "Workers", "Outbox Pattern", "N8N", "Spec Kit", "Agentes de IA", "PowerShell / Bash"],
  },
  {
    title: "Frontend y mobile",
    description: "Experiencia complementaria para plataformas desacopladas.",
    skills: ["Angular 11-21", "Nx monorepo", "Native Federation", "Signals", "RxJS", "SSR", "Tailwind CSS", "Android"],
  },
  {
    title: "Calidad, cloud y operación",
    description: "Código verificable, desplegable y preparado para evolucionar.",
    skills: ["JUnit 5", "Mockito", "JaCoCo", "SonarQube", "Docker", "Kubernetes", "AWS S3 / SES", "GitLab CI/CD"],
  },
]
---

<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
  {
    skillGroups.map((group) => (
      <article class="rounded-2xl border border-slate-200 bg-white/70 p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md dark:border-slate-800 dark:bg-slate-900/60">
        <h3 class="text-lg font-bold text-slate-950 dark:text-white">{group.title}</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">{group.description}</p>
        <ul class="mt-4 flex flex-wrap gap-2" aria-label={`Competencias de ${group.title}`}>
          {
            group.skills.map((skill) => (
              <li class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-200">
                {skill}
              </li>
            ))
          }
        </ul>
      </article>
    ))
  }
</div>
