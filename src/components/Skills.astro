---
import profile from "@/data/profile.json"

const skillGroups = profile.skillGroups
---

<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
  {
    skillGroups.map((group) => (
      <article class="rounded-2xl border border-slate-200 bg-white/70 p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md dark:border-slate-800 dark:bg-slate-900/60">
        <h3 class="text-lg font-bold text-slate-950 dark:text-white">{group.title}</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">{group.description}</p>
        <ul class="mt-4 flex flex-wrap gap-2" aria-label={`Competencias de ${group.title}`}>
          {
            group.skills.map((skill) => (
              <li class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-200">
                {skill}
              </li>
            ))
          }
        </ul>
      </article>
    ))
  }
</div>
