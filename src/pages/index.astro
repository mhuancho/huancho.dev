---
import Layout from "@/layouts/Layout.astro"

import AboutMe from "@/components/AboutMe.astro"
import Briefcase from "@/components/icons/Briefcase.astro"
import CodeIcon from "@/components/icons/Code.astro"
import Experience from "@/components/Experience.astro"
import Hero from "@/components/Hero.astro"
import ProfileCheck from "@/components/icons/ProfileCheck.astro"
import Projects from "@/components/Projects.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import Skills from "@/components/Skills.astro"
import SystemIcon from "@/components/icons/System.astro"
import TitleSection from "@/components/TitleSection.astro"
import profile from "@/data/profile.json"
---

<Layout title={profile.meta.title} description={profile.meta.description}>
  <main id="contenido" class="px-5 sm:px-6">
    <SectionContainer id="inicio" class="pb-20 pt-32 sm:pb-28 sm:pt-40">
      <Hero />
    </SectionContainer>

    <div class="space-y-24 pb-12 sm:space-y-32">
      <SectionContainer id="experiencia">
        <TitleSection>
          <Briefcase class="size-8" />
          Experiencia profesional
        </TitleSection>
        <Experience />
      </SectionContainer>

      <SectionContainer id="competencias">
        <TitleSection>
          <SystemIcon class="size-8" />
          Competencias técnicas
        </TitleSection>
        <Skills />
      </SectionContainer>

      <SectionContainer id="proyectos">
        <TitleSection>
          <CodeIcon class="size-7" />
          Proyectos destacados
        </TitleSection>
        <p class="-mt-4 mb-8 max-w-2xl leading-7 text-slate-600 dark:text-slate-400">
          Cinco de estos proyectos tienen un <a
            href="/casos-de-estudio"
            class="font-semibold text-blue-700 underline decoration-blue-400 decoration-2 underline-offset-4 hover:text-blue-900 dark:text-blue-300 dark:hover:text-blue-100"
            >caso de estudio detallado</a
          >: contexto, problema, decisiones de diseño y qué haría distinto.
        </p>
        <Projects />
      </SectionContainer>

      <SectionContainer id="sobre-mi">
        <TitleSection>
          <ProfileCheck class="size-8" />
          Perfil profesional
        </TitleSection>
        <AboutMe />
      </SectionContainer>
    </div>
  </main>
</Layout>
