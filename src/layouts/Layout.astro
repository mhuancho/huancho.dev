---
import "@fontsource-variable/onest"
import "@/styles/global.css"

import Footer from "../components/Footer.astro"
import Header from "../components/Header.astro"
import profile from "@/data/profile.json"
// Astro 5 renombro ViewTransitions -> ClientRouter; en Astro 7 (instalado aqui)
// ViewTransitions ya no existe.
import { ClientRouter } from "astro:transitions"

interface Props {
  title: string
  description: string
  /** Imagen social. Por defecto, la del perfil. */
  ogImage?: string
  /** Marca la página como no indexable. */
  noindex?: boolean
}

const { description, title, ogImage = profile.meta.ogImage, noindex = false } = Astro.props

const { meta } = profile
const siteUrl = (Astro.site?.href ?? `${meta.site}/`).replace(/\/$/, "")
const canonical = new URL(Astro.url.pathname, `${siteUrl}/`).href
const socialImage = new URL(ogImage, `${siteUrl}/`).href

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: meta.name,
  jobTitle: meta.role,
  description,
  url: `${siteUrl}/`,
  image: new URL(meta.image, `${siteUrl}/`).href,
  email: `mailto:${meta.email}`,
  address: { "@type": "PostalAddress", addressLocality: "Lima", addressCountry: "PE" },
  sameAs: [meta.links.linkedin, meta.links.github],
  knowsAbout: [
    "Java",
    "Spring Boot",
    "Quarkus",
    "Keycloak",
    "OAuth2",
    "OpenID Connect",
    "Multi-tenant architecture",
    "API Gateway",
    "Resilience4j",
    "RabbitMQ",
    "Angular",
  ],
  alumniOf: [
    { "@type": "EducationalOrganization", name: "Universidad Tecnológica del Perú" },
    { "@type": "EducationalOrganization", name: "IDAT" },
  ],
}

const siteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: `${meta.name} — ${meta.role}`,
  url: `${siteUrl}/`,
  inLanguage: meta.lang,
  author: { "@type": "Person", name: meta.name },
}
---

<!doctype html>
<html lang={meta.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#020617" media="(prefers-color-scheme: dark)" />
    <meta name="author" content={meta.name} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={meta.name} />
    <meta property="og:locale" content={meta.locale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${meta.name} — ${meta.role}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(siteSchema)} />
    <ClientRouter />
    <script is:inline>
      const savedTheme = localStorage.getItem("theme")
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches
      const useDark = savedTheme === "dark" || (savedTheme !== "light" && prefersDark)
      document.documentElement.classList.toggle("dark", useDark)
    </script>
  </head>

  <body class="relative min-h-screen overflow-x-hidden bg-slate-50 text-slate-950 antialiased dark:bg-slate-950 dark:text-white">
    <a
      href="#contenido"
      class="fixed left-4 top-4 z-[60] -translate-y-24 rounded-lg bg-slate-950 px-4 py-2 text-white transition focus:translate-y-0 dark:bg-white dark:text-slate-950"
    >
      Ir al contenido
    </a>
    <div
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 -z-10 bg-[radial-gradient(ellipse_80%_60%_at_50%_-20%,rgba(56,189,248,0.18),transparent_70%)] dark:bg-[radial-gradient(ellipse_80%_60%_at_50%_-20%,rgba(37,99,235,0.18),transparent_70%)]"
    ></div>
    <Header />
    <slot />
    <Footer />

    <style is:global>
      :root {
        color-scheme: light;
      }

      :root.dark {
        color-scheme: dark;
      }

      html {
        scroll-behavior: smooth;
        scroll-padding-top: 6rem;
        font-family: "Onest Variable", system-ui, sans-serif;
      }

      body {
        display: flex;
        min-height: 100vh;
        flex-direction: column;
        overscroll-behavior: none;
      }

      ::selection {
        background: rgb(186 230 253);
        color: rgb(12 74 110);
      }

      .dark ::selection {
        background: rgb(30 64 175);
        color: white;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </body>
</html>
